# Bind to 127.0.0.1 for local access. Set this to a LAN or Tailscale IP when needed.
ANYDATAS_HOST_BIND=127.0.0.1
ANYDATAS_PORT=28080
ANYDATAS_MAX_UPLOAD_BYTES=104857600
ANYDATAS_SESSION_TTL_DAYS=7
ANYDATAS_COOKIE_SECURE=0
# Agent 单次最大决策轮数、总超时和服务端上下文字符预算。
ANYDATAS_AGENT_MAX_STEPS=6
ANYDATAS_AGENT_TIMEOUT_SECONDS=300
ANYDATAS_AGENT_CONTEXT_CHARS=80000
RUST_LOG=anydatas_api=info,tower_http=info
